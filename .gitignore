.streamlit/secrets.toml
.agents/skills/developing-with-streamlit
.claude/skills/developing-with-streamlit

# ---------------------------------------------------------------------------
# Saídas do pipeline (dados derivados — não versionar)
# Entradas de referência e fixtures de teste ficam em data/raw/ e tests/data/,
# que NÃO são ignorados de propósito: são insumo de reprodutibilidade.
# ---------------------------------------------------------------------------
data/interim/
data/processed/
outputs/
runs/
logs/
*.log

# Artefatos químicos volumosos gerados pelo pipeline
*.sdf.gz
*.smi.gz
*.pkl
*.pickle
*.parquet
*.feather
*.h5
*.hdf5
*.sqlite
*.db

# Caches de cálculo (descritores, fingerprints)
.cache/
cache/

# ---------------------------------------------------------------------------
# Exceções: insumos de reprodutibilidade são versionados mesmo em formato
# binário (fixtures de teste e dados brutos de referência).
# ---------------------------------------------------------------------------
!tests/data/**
!data/raw/**
